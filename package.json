    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.74.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
